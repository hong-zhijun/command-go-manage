# Command Go Manage — 环境变量示例
# 复制为 .env 后修改

# 服务
PORT=3050
HOST=0.0.0.0

# ⚠️ 必须修改
JWT_SECRET=your-random-secret-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password

# CC 上游
CC_API_BASE=https://api.commandcode.ai

# 代理超时
CC_STREAM_IDLE_MS=30000
CC_NONSTREAM_IDLE_MS=90000
CC_MAX_BODY_MB=100

# 额度同步间隔（毫秒，默认 5 分钟）
QUOTA_REFRESH_INTERVAL_MS=300000

# 自定义 Key 前缀
API_KEY_PREFIX=sk-cg-

# 设备伪装（可选，改变所有 key 的设备指纹）
# CC_FINGERPRINT_SALT=
# CC_DEVICE_PROJECT_DIR=C:\Users\dev\projects\app
